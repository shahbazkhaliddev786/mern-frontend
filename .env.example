# This is an reference .env file. Copy this to .env.development and .env.production and update the values as needed.

# Server Side - these variables will be available in the server side code not client side code.
PORT="5000"
BACKEND_URL="https://dummyjson.com/test"

# Client Side - To use env variables in the client side code, they must be prefixed with VITE_.
VITE_ENVIRONMENT="development" # "staging", "testing", "production".
VITE_STRIPE_PUBLIC_KEY="pk_test_your_stripe_publishable_key"

# Shows the shopping assistant's chat launcher on store pages. Switch on together with the backend's AGENT_ENABLED.
VITE_AGENT_ENABLED="false"
